NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed to run `npm run seed` (scripts/seed.mjs) -- Supabase dashboard
# -> Project Settings -> API -> service_role key. Bypasses RLS; never used
# by the app itself, never expose to the client, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed site (used for link-preview images and
# password-reset links). Leave unset locally -> http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
